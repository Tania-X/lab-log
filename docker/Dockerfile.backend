# Lab Log 后端服务 Dockerfile（离线部署版）
FROM python:3.10

# 设置工作目录
WORKDIR /app

# 从本地 COPY 预下载的 ffmpeg 和 ffprobe
COPY docker/offline-tools/ffmpeg /usr/local/bin/
COPY docker/offline-tools/ffprobe /usr/local/bin/
RUN chmod +x /usr/local/bin/ffmpeg /usr/local/bin/ffprobe

# 从本地 COPY 预下载的 Python 包并安装（无需联网）
COPY docker/offline-packages /offline-packages
COPY docker/requirements.txt /app/
RUN pip install --no-index --find-links=/offline-packages -r requirements.txt

# 复制项目代码
COPY . /app

# 创建必要的目录
RUN mkdir -p logs_debug recordings

# 暴露端口
EXPOSE 8000

# 启动命令
CMD ["uvicorn", "web_api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
