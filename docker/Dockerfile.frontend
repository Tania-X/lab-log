# Lab Log 前端构建 Dockerfile
FROM node:20-alpine AS builder

# 设置工作目录
WORKDIR /app

# 复制 package 文件
COPY web_ui/package.json web_ui/package-lock.json ./

# 安装依赖
RUN npm ci

# 复制前端代码
COPY web_ui/ ./

# 构建生产版本
RUN npm run build

# 生产环境使用 Nginx 服务静态文件
FROM nginx:alpine

# 复制构建好的静态文件
COPY --from=builder /app/dist /usr/share/nginx/html

# 复制 Nginx 配置（从上级目录的 nginx 文件夹）
COPY ../nginx/nginx.conf /etc/nginx/conf.d/default.conf

# 暴露端口
EXPOSE 80

# 启动 Nginx
CMD ["nginx", "-g", "daemon off;"]
